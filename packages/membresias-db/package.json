{
  "name": "@dinamyt/membresias-db",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "default": "./dist/schema/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": ["dist", "drizzle"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:local:setup": "node scripts/pglite-setup.mjs",
    "zonas:ensayo": "node scripts/probar-zonas.mjs"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  }
}
