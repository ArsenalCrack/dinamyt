# Base de datos de DINAMYT Membresías (Neon, Supabase o cualquier PostgreSQL).
#
# Neon — copia la cadena "Pooled connection" del panel. El host lleva `-pooler`
# y por eso el cliente fuerza prepare:false. Si trae `&channel_binding=require`
# no pasa nada: el cliente lo quita solo (PostgreSQL lo rechazaría).
MEMBRESIAS_DATABASE_URL=postgresql://USUARIO:CLAVE@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Desarrollo local SIN servidor de base de datos: PGlite embebido en una
# carpeta. Si esta variable está definida, tiene prioridad sobre la de arriba.
# MEMBRESIAS_PGLITE_DATA=./.localdb
