# Base de datos de DINAMYT Membresías.
# Producción (Supabase / Postgres). Con el pooler de Supabase el cliente
# fuerza prepare:false automáticamente.
MEMBRESIAS_DATABASE_URL=postgresql://postgres:TU_PASSWORD@db.TU_PROJECT_REF.supabase.co:5432/postgres

# Desarrollo local SIN servidor de base de datos: PGlite embebido en una
# carpeta. Si esta variable está definida, tiene prioridad sobre la de arriba.
# MEMBRESIAS_PGLITE_DATA=./.localdb
