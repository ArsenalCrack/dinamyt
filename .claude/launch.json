        "--filter",
        "@dinamyt/membresias-web",
        "dev"
      ],
      "port": 3006
    },
    {
      "name": "membresias-agent",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@dinamyt/membresias-agent",
        "dev"
      ],
      "port": 7070
    },
    {
      "name": "academy-api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@dinamyt/academy-api",
        "dev"
      ],
      "port": 3007
    },
    {
      "name": "academy-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@dinamyt/academy-web",
        "dev"
      ],
      "port": 3008
    },
    {
      "name": "academy-figuras",
      "runtimeExecutable": "apps/academy-figuras/.venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "service.main:app",
        "--port",
        "3009",
        "--app-dir",
        "apps/academy-figuras"
      ],
      "port": 3009
    },
    {
      "//": "Campeonatos DE VERDAD, en D:/Repositorios/dinamyt-combat. Las entradas campeonatos-* de arriba apuntan a las copias VIEJAS del monorepo (productos/ es un espejo y apps/campeonatos-*-local es una copia sin commitear). Las variables las lee de backend/.env.",
      "name": "combat-api",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "D:/Repositorios/dinamyt-combat/backend/run.py"
      ],
      "port": 5000
    },
    {
      "name": "combat-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "D:/Repositorios/dinamyt-combat/frontend",
        "dev",
        "--port",
        "3003"
      ],
      "port": 3003
    }
