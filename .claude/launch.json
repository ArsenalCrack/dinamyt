{
  "version": "0.0.1",
  "configurations": [
    {
      "//": "Identidad y portal: este monorepo. PGlite en .localdb/ (README.md).",
      "name": "ecosystem-api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@dinamyt/ecosystem-api",
        "start:dev"
      ],
      "port": 3001
    },
    {
      "name": "ecosystem-portal",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@dinamyt/ecosystem-portal",
        "dev"
      ],
      "port": 3000
    },
    {
      "//": "Membresías DE VERDAD, en D:/Repositorios/dinamyt-membresias (productos/membresias es solo un espejo, sin node_modules). --dir hace que pnpm resuelva el workspace de ese repositorio.",
      "name": "membresias-api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "D:/Repositorios/dinamyt-membresias/apps/membresias-api",
        "dev"
      ],
      "port": 3004
    },
    {
      "name": "membresias-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "D:/Repositorios/dinamyt-membresias/apps/membresias-web",
        "dev"
      ],
      "port": 3006
    },
    {
      "//": "Campeonatos DE VERDAD, en D:/Repositorios/dinamyt-combat (productos/campeonatos es solo un espejo). Las variables las lee de backend/.env; API y Socket.IO en :5000.",
      "name": "campeonatos-api",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "D:/Repositorios/dinamyt-combat/backend/run.py"
      ],
      "port": 5000
    },
    {
      "name": "campeonatos-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "D:/Repositorios/dinamyt-combat/frontend",
        "dev",
        "--port",
        "3003"
      ],
      "port": 3003
    },
    {
      "//": "Academy: este monorepo. Antes, con las APIs apagadas: pnpm --filter @dinamyt/academy-db db:local:setup.",
      "name": "academy-api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@dinamyt/academy-api",
        "dev"
      ],
      "port": 3007
    },
    {
      "name": "academy-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@dinamyt/academy-web",
        "dev"
      ],
      "port": 3008
    },
    {
      "name": "academy-figuras",
      "runtimeExecutable": "apps/academy-figuras/.venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "service.main:app",
        "--port",
        "3009",
        "--app-dir",
        "apps/academy-figuras"
      ],
      "port": 3009
    }
  ]
}
