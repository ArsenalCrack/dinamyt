# Dependencias
node_modules/

# Builds
dist/
.next/
.turbo/
*.tsbuildinfo

# BD local embebida (PGlite) — datos de desarrollo, nunca versionar
.localdb/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Entorno y secretos — NUNCA versionar
# El patrón `.env*.local` (sin punto antes del *) también atrapa `.env.local`,
# que es el que usa Next en desarrollo.
.env
.env*.local
!.env.example
*.pem

# OS / editores
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
