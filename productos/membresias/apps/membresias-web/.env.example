# ── Web de DINAMYT Membresías (Next, puerto 3006) ────────────────────────────
#
# Origen REAL de la API. Lo usa el rewrite de next.config.ts, en el servidor: el
# navegador nunca habla con él directamente, siempre a través de /api en este
# mismo dominio. Eso es lo que mantiene la cookie de sesión como de primera
# parte y hace que la sesión aguante una recarga en cualquier navegador.
# En Vercel: la URL del servicio de Render.
MEMBRESIAS_API_ORIGIN=http://127.0.0.1:3004

# NO definir en el despliegue normal. Apunta el navegador a un origen absoluto
# y salta el proxy, con lo que la cookie vuelve a ser de terceros y Safari la
# bloquea (la sesión se pierde al recargar).
# NEXT_PUBLIC_API_URL=

# Clave pública VAPID (la MISMA que en membresias-api). Sin ella, el botón de
# avisos push avisa que falta configurarla.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Secreto del cron diario de avisos, EL MISMO que en la API.
#   · Vercel lo usa para firmar la llamada a /cron/avisos (lo hace solo).
#   · Esa ruta lo reenvía a la API, que solo acepta la suya con este valor.
# Sin él no hay avisos automáticos: quedan a que el maestro pulse el botón.
CRON_SECRET=

# Moneda y formato de los montos. Por defecto peso colombiano.
# NEXT_PUBLIC_MONEDA=COP
# NEXT_PUBLIC_LOCALE_MONEDA=es-CO

# ── SSO con el ecosistema DINAMYT (OPCIONAL) ─────────────────────────────────
# El botón «Entrar con el portal DINAMYT» solo aparece si la API responde que
# el SSO está activo Y esta variable está definida.
# NEXT_PUBLIC_ECOSYSTEM_PORTAL_URL=https://dinamyt-ecosystem-portal.vercel.app
