# Base de datos de DINAMYT Membresías (Supabase, Neon o cualquier PostgreSQL).
#
# Supabase — Connect → pestaña "Transaction pooler" (puerto 6543). NO la
# conexión directa: esa solo responde por IPv6 y Render no sale por IPv6.
# El cliente fuerza TLS aunque la cadena no traiga `sslmode`.
MEMBRESIAS_DATABASE_URL=postgresql://postgres.PROJECT_REF:CLAVE@aws-0-REGION.pooler.supabase.com:6543/postgres

# Desarrollo local SIN servidor de base de datos: PGlite embebido en una
# carpeta. Si esta variable está definida, tiene prioridad sobre la de arriba.
# MEMBRESIAS_PGLITE_DATA=./.localdb
