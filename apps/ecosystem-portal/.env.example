# API del ecosystem (identidad y suscripciones).
NEXT_PUBLIC_ECOSYSTEM_API_URL=http://localhost:3001

# URLs de las apps del ecosistema (para los accesos directos del dashboard).
NEXT_PUBLIC_CAMPEONATOS_URL=http://localhost:3003
NEXT_PUBLIC_MEMBRESIAS_URL=http://localhost:3006
NEXT_PUBLIC_ACADEMY_URL=http://localhost:3008

# Los dos buzones que enseña el portal, y son dos a propósito: soporte@ para
# problemas de cuenta (va en el pie de TODAS las pantallas) y admin@ para lo
# administrativo (planes, cotizaciones, habeas data). Estos valores por defecto
# ya son los buenos en producción; están aquí para poder cambiarlos sin tocar
# código. Al ser NEXT_PUBLIC_*, cambiarlas obliga a volver a compilar el portal.
NEXT_PUBLIC_SUPPORT_CONTACT_EMAIL=soporte@dinamyt.org
NEXT_PUBLIC_ADMIN_CONTACT_EMAIL=admin@dinamyt.org
