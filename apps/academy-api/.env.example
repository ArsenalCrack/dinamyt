# API de DINAMYT Academy (Fastify). No emite tokens: los verifica contra el JWKS
# del ecosystem. Puerto 3007 (ecosystem 3001, portal 3000, campeonatos-api 3002/web 3003,
# membresias-api 3004/web 3006, academy-web 3008).
PORT=3007
ECOSYSTEM_JWKS_URL=http://localhost:3001/auth/jwks
ECOSYSTEM_PORTAL_URL=http://localhost:3000
ACADEMY_WEB_URL=http://localhost:3008
CORS_ORIGINS=http://localhost:3000,http://localhost:3008

# BD propia (ver packages/academy-db/.env.example)
ACADEMY_DATABASE_URL=postgresql://postgres:TU_PASSWORD@db.TU_PROJECT_REF.supabase.co:5432/postgres

# Alternativa local sin servidor (PGlite): carpeta de datos embebida
# (correr antes `pnpm --filter @dinamyt/academy-db db:local:setup` con la misma ruta).
# ACADEMY_PGLITE_DATA=../../packages/academy-db/.localdb
