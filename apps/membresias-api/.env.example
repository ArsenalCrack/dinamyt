# ── API de DINAMYT Membresías (Fastify, puerto 3004) ─────────────────────────
PORT=3004

# Base de datos (ver packages/membresias-db/.env.example).
# Supabase: usa la cadena del "Transaction pooler" (puerto 6543), no la directa.
MEMBRESIAS_DATABASE_URL=postgresql://postgres.PROJECT_REF:CLAVE@aws-0-REGION.pooler.supabase.com:6543/postgres
# Alternativa local sin servidor:
# MEMBRESIAS_PGLITE_DATA=./.localdb

# ── Identidad ────────────────────────────────────────────────────────────────
# Secreto con el que se firman los tokens. Mínimo 32 caracteres. Genéralo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Vida del token en segundos (24 h).
JWT_EXPIRES_IN=86400
# Costo de bcrypt. 10 es el equilibrio entre seguridad y CPU compartida.
BCRYPT_ROUNDS=10

# Cuenta inicial: la siembra la API al arrancar, y solo si no existe ya.
# Cambiar la contraseña aquí NO reescribe una que el superadmin ya cambió.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_NOMBRE=Super administrador

# ── Red ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3006
MEMBRESIAS_WEB_URL=http://localhost:3006
# Proxies de confianza delante de la API. 0 en local; 1 detrás de Render. Sin
# esto, en producción todas las peticiones comparten la IP del proxy y el rate
# limit por IP se vuelve un cupo global.
TRUST_PROXY_HOPS=0

# ── Cookie de sesión ─────────────────────────────────────────────────────────
# El token va en una cookie httpOnly, no en localStorage: así un script
# inyectado en la página no puede leerlo.
#
# COOKIE_SAMESITE decide si la sesión sobrevive al despliegue:
#   · "lax"  — web y API en el MISMO sitio (localhost, o app.midominio.com +
#              api.midominio.com). Es lo recomendable.
#   · "none" — dominios distintos (Vercel + Render). La cookie pasa a ser de
#              terceros: Safari la bloquea siempre y Firefox la aísla, así que
#              la sesión se pierde al recargar en esos navegadores. Si acabas
#              aquí, lo que toca es poner ambos bajo un dominio propio.
COOKIE_SAMESITE=lax
# "none" fuerza Secure por su cuenta. Ponlo en true si sirves por HTTPS.
COOKIE_SECURE=false

# ── Avisos push (opcional) ───────────────────────────────────────────────────
# Genera el par con: pnpm --filter @dinamyt/membresias-api gen:vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@tudominio.com

# ── Disparo diario de avisos ─────────────────────────────────────────────────
# Sin esto, los avisos solo existen cuando el maestro pulsa «Generar avisos».
# Con esto, POST /notifications/cron recorre todos los clubes cada mañana; quien
# lo llama es el cron de Vercel a través de la web (apps/membresias-web/src/app/
# cron/avisos/route.ts), porque el plan gratuito de Render no tiene tareas
# programadas.
#
# El MISMO valor tiene que estar en Vercel. Sin la variable, la ruta responde
# 404: no puede quedar abierta, es la única que actúa sin sesión.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=

# ── SSO con el ecosistema DINAMYT (OPCIONAL) ─────────────────────────────────
# Sin estas variables, Membresías funciona de forma totalmente autónoma. Con
# ellas, además acepta tokens del ecosistema para usuarios ya dados de alta
# aquí (se resuelven por correo; nunca se crea una cuenta en silencio).
# ECOSYSTEM_JWKS_URL=https://dinamyt-ecosystem-api.onrender.com/auth/jwks
# ECOSYSTEM_PORTAL_URL=https://dinamyt-ecosystem-portal.vercel.app

# ── El espejo del portal (va con las dos de arriba) ──────────────────────────
# Los datos de la persona —nombre, foto, cinturón, sangre, emergencias— se
# editan en DINAMYT y aquí solo se leen. Pero el carnet lo imprime ESTA app con
# SU tabla, así que el portal avisa cuando alguien guarda una ficha allí y con
# ese aviso se actualiza la copia (POST /sync/persona, POST /sync/club).
#
# Sin la variable esas dos rutas responden 404 y la copia se queda como esté:
# nada se rompe, pero la foto que el maestro suba en el portal no saldrá en el
# carnet. El MISMO valor tiene que estar en ecosystem-api.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# ECOSYSTEM_SYNC_SECRET=

