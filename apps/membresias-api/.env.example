# API de DINAMYT Membresías (Fastify). No emite tokens: los verifica contra el JWKS
# del ecosystem. Puerto 3004 (ecosystem 3001, portal 3000, campeonatos-api 3002/web 3003).
PORT=3004
ECOSYSTEM_JWKS_URL=http://localhost:3001/auth/jwks
ECOSYSTEM_API_URL=http://localhost:3001
ECOSYSTEM_PORTAL_URL=http://localhost:3000
MEMBRESIAS_WEB_URL=http://localhost:3006
CORS_ORIGINS=http://localhost:3000,http://localhost:3006

# BD propia (ver packages/membresias-db/.env.example)
MEMBRESIAS_DATABASE_URL=postgresql://postgres:TU_PASSWORD@db.TU_PROJECT_REF.supabase.co:5432/postgres

# Cifrado de datos sensibles (plantillas biométricas). Cualquier cadena robusta.
FIELD_ENCRYPTION_KEY=

# Web Push (genera con: pnpm --filter @dinamyt/membresias-api gen:vapid)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@dinamyt.com

# Email de respaldo (best-effort). Gmail: MAIL_USER + MAIL_PASS (app password).
MAIL_USER=
MAIL_PASS=
