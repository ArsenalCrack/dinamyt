# Servidor
PORT=3002
# Orígenes permitidos (separados por coma): campeonatos-web (3003) consume esta API.
CORS_ORIGINS=http://localhost:3000,http://localhost:3003

# Integración con el ecosystem (auth delegada)
ECOSYSTEM_JWKS_URL=http://localhost:3001/auth/jwks
ECOSYSTEM_PORTAL_URL=http://localhost:3000

# Base de datos propia de Campeonatos
CAMPEONATOS_DATABASE_URL=postgresql://postgres:TU_PASSWORD@db.TU_PROJECT_REF.supabase.co:5432/postgres

# SMTP para correos de invitacion (opcional: sin SMTP_HOST, solo in-app)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=tu-correo@gmail.com
# SMTP_PASS=clave-de-aplicacion
# SMTP_FROM=DINAMYT <no-reply@dinamyt.com>
# URL publica de campeonatos-web (enlaces de los correos)
# CAMPEONATOS_WEB_URL=http://localhost:3003
