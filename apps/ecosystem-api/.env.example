# ── Base de datos (PostgreSQL / Supabase) ────────────────────────────────────
# Connection string de tu proyecto. Con el pooler de Supabase, db/index.ts
# fuerza prepare:false automáticamente.
DATABASE_URL=postgresql://postgres:TU_PASSWORD@db.TU_PROJECT_REF.supabase.co:5432/postgres
DB_SCHEMA=ecosystem

# ── JWT (RS256) ───────────────────────────────────────────────────────────────
# El ecosistema FIRMA los tokens con la clave privada y publica la pública en
# /auth/jwks para que las apps (academy, campeonatos) los verifiquen.
# Genera el par una sola vez (ver README) y NUNCA subas la privada a git.
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_EXPIRES_IN=86400

# ── Servidor ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
# Orígenes permitidos para CORS (separados por coma): portal + apps.
# El portal (3000), campeonatos-web (3003), membresias-web (3006) y
# academy-web (3008) llaman a esta API para el login.
CORS_ORIGINS=http://localhost:3000,http://localhost:3003,http://localhost:3006,http://localhost:3008

# ── Correo (OTP de verificación y recuperación de contraseña) ─────────────────
# Cuenta Gmail con "contraseña de aplicación".
MAIL_USER=
MAIL_PASS=

# ── Super administrador inicial (usado por `npm run db:seed`) ─────────────────
ADMIN_EMAIL=admin@dinamyt.com
ADMIN_PASSWORD=CambiaEstaClaveFuerte123!
ADMIN_NAME=Super Administrador DINAMYT
ADMIN_DOCUMENT=1000000000

# ── El espejo de Membresías (OPCIONAL) ───────────────────────────────────────
# Los datos de la persona se editan AQUÍ y solo aquí: la misma cuenta entra al
# portal, a Campeonatos y a Academy. Pero quien imprime el carnet es Membresías,
# que lo pinta con su propia tabla — así que al guardar una ficha se le avisa
# para que actualice su copia (POST /sync/persona, POST /sync/club allí).
#
# Con las dos vacías no se avisa a nadie y no pasa nada: es el caso de un
# ecosistema sin Membresías al lado. El secreto tiene que ser EL MISMO que
# `ECOSYSTEM_SYNC_SECRET` en membresias-api.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# MEMBRESIAS_SYNC_URL=https://membresias-api.dinamyt.org
# ECOSYSTEM_SYNC_SECRET=

