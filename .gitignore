# Dependencias
node_modules/

# Builds
dist/
.next/
.turbo/
*.tsbuildinfo
# Lo reescribe `next build` en cada compilación —y su contenido cambia con la
# versión de Next y con si `.next/` existe—, así que versionarlo garantiza un
# conflicto en el servidor: `git pull` se planta con «your local changes would
# be overwritten by merge». No hay nada que conservar: se regenera solo.
# `ecosystem-portal` ya lo ignoraba en el suyo; a `academy-web` le faltaba.
next-env.d.ts

# BD local embebida (PGlite) — datos de desarrollo, nunca versionar
.localdb/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Entorno y secretos — NUNCA versionar
.env
.env.*.local
**/keys/
*.pem

# OS / editores
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Almacen local de archivos de Academy (videos de figuras, reportes)
.uploads/

# Python (microservicio de figuras)
.venv/
__pycache__/
*.pyc

# Grafo de conocimiento (graphify) — se regenera con `/graphify . --update`
graphify-out/

# Campaña de diseño: capturas de antes y después (se regeneran con
# playwright-cli, auditoria/ESTADO.md) y los archivos de trabajo de la skill
# design-taste-frontend
auditoria/capturas/
.taste-skill/

# El proyecto de los videos instructivos vive en su propio repositorio
dinamyt-videos-proyecto.zip
# Las contraseñas de prueba de las capturas (las genera auditoria/herramientas)
auditoria/herramientas/cuentas.json
